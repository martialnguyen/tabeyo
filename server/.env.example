PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=anipad@gmail.com
ADMIN_PASSWORD=ducan287
ADMIN_TOKEN=dev-admin-token-change-me
CRON_SECRET=dev-cron-secret-change-me
SCOUT_INGEST_SECRET=dev-scout-ingest-secret-change-me
ENABLE_AUTO_SOLD=true

# Firebase Admin credentials. Use option A or option B.
# Option A: path to the service account JSON file downloaded from Firebase Console.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B: paste individual fields from the service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Discord notifications for new orders and new scout results
DISCORD_WEBHOOK_URL=

# Optional: AI verification of public Japanese listings. Without it, matches need manual review.
OPENAI_API_KEY=
OPENAI_SCOUT_MODEL=gpt-4o-mini
ENABLE_IPAD_SCOUT=false
